# Heimdall Environment Configuration Example
HEIMDALL_ENV=development
HEIMDALL_DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/heimdall

# Bifrost Data Hub
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=agentpay_live_secret

# LLM Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# Hyperliquid (Arbitrum / L1)
HYPERLIQUID_TESTNET=true
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# Binance (Optional)
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Master Encryption Key (32-byte hex for AES-256-GCM vault)
HEIMDALL_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
