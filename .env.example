# ==============================================================================
# Heimdall AI Quant Trading Platform - Production Environment Configuration
# ==============================================================================

# 0. Docker 镜像仓库与端口配置（从远程 Hub 拉取时指定）
DOCKER_REGISTRY=your_dockerhub_or_registry
IMAGE_TAG=latest
HOST_BIND_IP=127.0.0.1
WEB_PORT=3005

HEIMDALL_ENV=production
HEIMDALL_DEBUG=false

# 1. 数据库配置（使用 Docker 部署时设置以下 3 项，Compose 会自动安全拼装 postgres:5432 内部连接串）：
#    POSTGRES_PASSWORD 为必填项，必须替换为强随机值（≥12 位，例如: openssl rand -hex 24）：
#    - 未设置：docker compose 直接报错退出；
#    - 仍为下方占位符或常见弱口令：生产环境（HEIMDALL_ENV=production）后端拒绝启动，任何环境下 MAINNET 实盘均被拒绝。
#    ⚠️ 已初始化过的 PostgreSQL 数据卷不会因修改本变量而改密，需先在库内执行 ALTER USER 同步修改。
POSTGRES_USER=heimdall
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=heimdall

# （可选）若非 Docker 部署或需单独连接外部已有数据库，取消以下注释（支持 postgresql+asyncpg://）：
# HEIMDALL_DATABASE_URL=postgresql+asyncpg://heimdall:your_strong_password_here@postgres:5432/heimdall
# DATABASE_URL=postgresql+asyncpg://heimdall:your_strong_password_here@postgres:5432/heimdall

# 2. 安全鉴权与 CORS 白名单（逗号分隔，严禁生产配置 *）
HEIMDALL_CORS_ORIGINS=https://trading.yourdomain.com,http://localhost:5173
HEIMDALL_SESSION_TTL_HOURS=24

# 3. 外部死信心跳守护 (Dead Man's Switch，例如 Healthchecks.io / Uptime Kuma)
HEIMDALL_HEARTBEAT_URL=

# 4. 告警通知 Webhook（可选：飞书 / 钉钉 / Telegram / Slack）
HEIMDALL_ALERT_WEBHOOK_URL=

# 5. LLM 推理大模型密钥（也可在前端密钥金库按钱包隔离加密托管）
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 6. 交易所默认配置（实盘密钥推荐通过前端 AES-256-GCM 安全金库托管）
HYPERLIQUID_TESTNET=true
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 7. AES-256-GCM 金库主密钥（32 字节 Hex；留空将自动生成并 chmod 0600 落盘至 data/.vault.key）
#    若填写必须是 64 位十六进制（例如: openssl rand -hex 32），格式非法时启动预检判定为 CRITICAL。
HEIMDALL_MASTER_KEY=

# 8. 部署安全预检豁免（仅限排障临时使用，默认关闭）：
#    设为 true 时，生产环境存在弱口令等 CRITICAL 问题也允许后端启动；对 MAINNET 实盘无效，实盘仍会被拒绝。
# HEIMDALL_ALLOW_INSECURE_DEFAULTS=false

# 9. 手动沙盒下单指定成交价相对跨所实时中位价的最大偏差（小数，默认 0.01 即 1%）
# HEIMDALL_PAPER_PRICE_MAX_DEVIATION_PCT=0.01

# 10. 单实例运行锁（审计 L3）：同一个数据库只允许一个后端进程运行，避免重复恢复机器人、重复下单
#    required（默认）：已有进程持锁时拒绝启动；warn：只告警继续启动（仅限排障）；off：不加锁
# HEIMDALL_INSTANCE_LOCK=required

# 11. 止损覆盖自动补挂的兜底距离（找不到已有止损价和开仓单止损计划时使用，默认 0.05 即 5%，范围 0.5%–50%）
# HEIMDALL_FALLBACK_STOP_LOSS_PCT=0.05
